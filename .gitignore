.nsh/
.stow/
out/
server/.stage/
node_modules/
.DS_Store

# everything under generated/ is runtime output, not source: the R*.tsx
# mini apps the model writes, the index.tsx registry the server rebuilds
# (writeIndex), the chat DB, files, attachments, avatars
generated/

# published Mini Apps are runtime artifacts too (widgets/index.tsx — the
# shelf UI — IS source and stays tracked)
widgets/R*.tsx

# regenerated per pop-out / snapshot — runtime artifacts
windows/

# compiled artifacts
native-widget/build/
tools/*.dylib

# signing keys for `just publish-signed` — keep offline, never commit
keys/
*.secret
